{
  "name": "@liftbay/sdk",
  "version": "0.1.2",
  "description": "Typed client for the Liftbay API, generated from its OpenAPI document.",
  "keywords": [
    "liftbay",
    "api",
    "openapi",
    "sdk",
    "react-native"
  ],
  "homepage": "https://liftbay.dev/docs",
  "bugs": {
    "url": "https://github.com/liftbay/sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liftbay/sdk.git"
  },
  "license": "Apache-2.0",
  "author": "Liftbay",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsup": "^8.5.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
